# Copy to .assets/env.props and fill in to build signed release builds.
# Without env.props, the app builds as io.sofluffy.mcu and release builds are
# signed with the debug key.
androidAppPackageName=io.sofluffy.mcu
androidKeyAlias=upload
androidKeyPassword=
androidStoreFile=upload-keystore.jks
androidStoreFilePassword=

# AdMob IDs. Without them, Google's sample IDs are used.
admobAppId=ca-app-pub-3940256099942544~3347511713
admobJobManagerAdUnitId=ca-app-pub-3940256099942544/2247696110
admobFilePickerAdUnitId=ca-app-pub-3940256099942544/2247696110
admobOutputFormatPickerAdUnitId=ca-app-pub-3940256099942544/2247696110
admobPreviewPageAdUnitId=ca-app-pub-3940256099942544/2247696110
